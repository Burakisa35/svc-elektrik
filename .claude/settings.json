{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/koruma.py\"" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(knowledge/**)",
      "Edit(docs/**)",
      "Write(knowledge/**)",
      "Write(docs/**)"
    ]
  }
}
